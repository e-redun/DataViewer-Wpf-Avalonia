<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Common.ViewModels"
                    xmlns:v="using:DataViewer.UI.Avalonia.Views"
                    >
    <DataTemplate DataType="vm:DatabasesViewModel"
                  x:Key="DatabasesTemplate"
                  >
        <v:DatabasesView />
    </DataTemplate>

    <DataTemplate DataType="vm:TablesViewModel"
                  x:Key="TablesTemplate"
                  >
        <v:TablesView />
    </DataTemplate>

    <DataTemplate DataType="vm:TableContentViewModel"
                  x:Key="TableContentTemplate"
                  >
        <v:TableContentView />
    </DataTemplate>

    <DataTemplate DataType="vm:PropertiesViewModel"
                  x:Key="PropertiesTemplate"
                  >
        <v:PropertiesView />
    </DataTemplate>

</ResourceDictionary>
