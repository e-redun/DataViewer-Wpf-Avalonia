<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 
    <Thickness x:Key="NoMargin">0</Thickness>
    <Thickness x:Key="AllMargin">20,20,20,20</Thickness>
    <Thickness x:Key="TopMargin">0,20,0,0</Thickness>
    <Thickness x:Key="LeftMargin">20,0,0,0</Thickness>
</ResourceDictionary>
