<Window 
        x:Class="DataViewer.UI.Avalonia.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:system="using:System"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        Title="DataViewer (Avalonia)"
        WindowStartupLocation="CenterScreen"
        xmlns:vm="using:Common.ViewModels"
        x:DataType="vm:MainWindowModel"
        >
    <Grid Margin="{StaticResource AllMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Ряд 0  -->
        <ContentControl 
            Content="{Binding DataBasesVM}"/>

        <ContentControl 
            Content="{Binding TablesVM}"
            Grid.Column="1"
            Margin="{StaticResource LeftMargin}"
            />

        <ContentControl 
            Content="{Binding TableContentVM}"
            Grid.Column="2"
            Margin="{StaticResource LeftMargin}"
            />

        <ContentControl 
            Content="{Binding PropertiesVM}"
            Grid.Column="3"
            Margin="{StaticResource LeftMargin}"
            />

        
        <!--  Ряд 1  -->
        <Button
            Grid.Row="1"
            Grid.Column="3"
            Margin="{StaticResource TopMargin}"
            HorizontalAlignment="Right"
            Command="{Binding CloseApplicationCommand}"
            Content="Закрыть"
            IsCancel="True" />

    </Grid>
    
</Window>
