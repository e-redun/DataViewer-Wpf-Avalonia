<UserControl x:Class="DataViewer.UI.Avalonia.Views.PropertiesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Common.ViewModels"
             xmlns:hlp="using:DataViewer.UI.Avalonia.Helpers"
             x:DataType="vm:PropertiesViewModel"
             >
    <DockPanel >
        <TextBlock
            DockPanel.Dock="Top"
            Text="{Binding Header}" />
        
        <Border
            Margin="{StaticResource TopMargin}"
            BorderBrush="Gray"
            BorderThickness="1">
            <ItemsControl
                Grid.IsSharedSizeScope="True"
                Background="Transparent"
                ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <hlp:FieldTemplateSelector/>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

    </DockPanel >      
</UserControl>
