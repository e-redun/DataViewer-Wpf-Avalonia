<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:v="clr-namespace:DataViewer.UI.Wpf.Views"
    xmlns:vm="clr-namespace:Common.ViewModels;assembly=Common">

    <DataTemplate DataType="{x:Type vm:DataBasesViewModel}">
        <v:DataBasesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TablesViewModel}">
        <v:TablesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TableContentViewModel}">
        <v:TableContentView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PropertiesViewModel}">
        <v:PropertiesView />
    </DataTemplate>

</ResourceDictionary>