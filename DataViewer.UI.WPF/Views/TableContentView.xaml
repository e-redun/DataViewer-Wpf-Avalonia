<UserControl
    x:Class="DataViewer.UI.Wpf.Views.TableContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:DataViewer.UI.Wpf.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:DataViewer.UI.Wpf.Views"
    d:DesignHeight="450"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <DockPanel Background="Transparent">

        <TextBlock
            DockPanel.Dock="Top"
            Text="{Binding Header}" />

            <!--ItemsSource="{Binding Rows}"-->
        <DataGrid
            ext:DataGridExtensions.DynamicRows="{Binding Rows, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding Rows}"
            HeadersVisibility="Column"
            Margin="{StaticResource TopMargin}"
            Background="Transparent"
            SelectedItem="{Binding SelectedRow}"
            />

    </DockPanel>
</UserControl>